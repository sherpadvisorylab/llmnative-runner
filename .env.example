# The .env of ONE company on a runner: /opt/playbook/companies/<company>/.env (scripts/runner-env.mjs
# writes it from the studio). The settings of the machine (image, limits) are in the compose of the runner.

# --- GitHub App of the company (Settings > Developer settings > GitHub Apps > the App) ---
GITHUB_APP_ID=
# The private key, on one line with \n for the line breaks; or mount the .pem and set the _FILE variant.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# Only when the App is installed on more than one account.
# GITHUB_INSTALLATION_ID=
# The webhook secret of the App. Without it the dispatcher only reconciles (every RECONCILE_MINUTES).
GITHUB_WEBHOOK_SECRET=

# Port of the dispatcher on the machine (127.0.0.1 only), when 8080 is taken.
# DISPATCHER_PORT=8080

# The token the studio of the company sends to follow the dispatcher live (/state, /events).
# Generate it here (openssl rand -hex 32) and paste it in the studio, Projects > Dispatcher.
DISPATCHER_TOKEN=

# --- Turns ---
# The agent image (built by `docker compose --profile build build`, or pulled).
AGENT_IMAGE=playbook-agent:1.19.3
# Turns at once on this machine: about 2 GB of RAM each.
MAX_PARALLEL=1
# Seconds a turn may last.
TURN_TIMEOUT=3600
# Failed turns in a row before the issue goes to a person, blocked.
FAILURES_TO_BLOCK=2
RECONCILE_MINUTES=10
# Memory limit of each turn container, e.g. 4g (empty: none).
AGENT_MEMORY=
# Docker network of the turns (empty: the default bridge).
AGENT_NETWORK=

# --- Keys of the model providers, handed to every turn (set only those the agents use) ---
OPENCODE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_KEY=
# Other variables to hand to the turns, by name, comma-separated.
# AGENT_ENV=

# --- Memory of the company (when the workflow uses it), as JSON: {"url":"…","apiKey":"…"} ---
# PLAYBOOK_MEMORY=

# --- Only with `--profile proxy` (a machine without a reverse proxy) ---
# DISPATCHER_DOMAIN=dispatcher.example.com
