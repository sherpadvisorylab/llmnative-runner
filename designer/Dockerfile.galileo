# The design agent Galileo: one container per design session, as the Matt image (Dockerfile), with
# the skill of Playbook that maps a software that already exists (runner/designer/galileo). It reads
# the clone, the spaces of the memory the person chose and the files they gave, asks only what those
# cannot tell, and writes the as-built documents in `as-built/`, which alone go to the pull request.
FROM node:24-bookworm-slim

# opencode at a fixed version, the same as the agent image.
ARG OPENCODE_VERSION=1.19.3
# The skill is of this repository: its version is the release of the runner.
ARG RUNNER_VERSION=dev
ARG SKILLS="galileo"

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates tini curl ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g "opencode-ai@${OPENCODE_VERSION}" \
    && npm cache clean --force

RUN useradd --create-home --uid 10001 agent && mkdir -p /work/notes && chown -R agent:agent /work

COPY --chown=agent:agent galileo/ /home/agent/.config/opencode/skills/galileo/
COPY --chmod=0755 entrypoint.sh /usr/local/bin/playbook-designer
COPY --chmod=0755 design-files.mjs /usr/local/bin/playbook-design-files
# The memory of the company, read only: the spaces the person chose (memory_search, _list, _read).
COPY --chmod=0755 memory.mjs /usr/local/lib/playbook/memory.mjs
RUN ln -s /usr/local/lib/playbook/memory.mjs /usr/local/bin/playbook-memory
COPY --chown=agent:agent opencode.json /home/agent/.config/opencode/opencode.json
# How to talk with the studio, then the flow of a Galileo session.
COPY --chown=agent:agent AGENTS.md galileo.md /tmp/agents/
RUN cat /tmp/agents/AGENTS.md /tmp/agents/galileo.md > /home/agent/.config/opencode/AGENTS.md \
    && chown agent:agent /home/agent/.config/opencode/AGENTS.md && rm -rf /tmp/agents

USER agent
WORKDIR /work
ENV HOME=/home/agent
# What goes to the pull request: the as-built documents (and the files the person gave, in inputs/).
ENV PLAYBOOK_DESIGN_OUTPUTS=as-built
EXPOSE 4096
LABEL org.opencontainers.image.title="playbook-design-galileo" \
      org.opencontainers.image.description="The design agent Galileo of Playbook: maps a software that already exists, from its code, the memory and the person" \
      playbook.design.kit="galileo" \
      playbook.design.name="Galileo" \
      playbook.design.command="galileo" \
      playbook.design.skills="${SKILLS}" \
      playbook.design.source="https://github.com/sherpadvisorylab/llmnative-playbook" \
      playbook.design.commit="${RUNNER_VERSION}" \
      playbook.design.opencode="${OPENCODE_VERSION}"

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/playbook-designer"]
